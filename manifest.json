{
  "manifest_version": 3,
  "name": "WhatsApp Web Resizer",
  "short_name": "WA Resizer",
  "version": "1.0.0",
  "description": "Ajusta el ancho de la lista de chats en WhatsApp Web arrastrando el borde con el mouse y la oculta automáticamente cuando la ventana del navegador es estrecha.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}